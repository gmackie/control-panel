{
  "name": "@gmac/control-panel-mcp",
  "version": "0.1.0",
  "description": "MCP server for GMAC.IO Control Panel - provides AI assistants access to application monitoring, deployments, and infrastructure management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gmac-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "control-panel",
    "devops",
    "kubernetes",
    "monitoring",
    "deployments"
  ],
  "author": "GMAC.IO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gmackie/control-panel.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://control.gmac.io",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "superjson": "^2.2.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  }
}
