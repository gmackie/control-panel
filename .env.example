# =============================================================================
# GMAC.IO Control Panel - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# Required variables are marked with [REQUIRED]
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
SITE_NAME="GMAC Control Panel"

# -----------------------------------------------------------------------------
# Authentication [REQUIRED]
# -----------------------------------------------------------------------------
# NextAuth.js configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# GitHub OAuth (for admin login)
GITHUB_ID=your-github-oauth-app-id
GITHUB_SECRET=your-github-oauth-app-secret
GITHUB_USERNAME=your-github-username

# -----------------------------------------------------------------------------
# Database [REQUIRED - choose one]
# -----------------------------------------------------------------------------
# Option 1: Neon PostgreSQL (recommended for production)
NEON_DATABASE_URL=postgresql://user:password@host/database
NEON_API_KEY=your-neon-api-key

# Option 2: Turso (distributed SQLite)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
TURSO_ORG_SLUG=your-turso-org

# Legacy/alternative
DATABASE_URL=postgresql://user:password@host/database

# -----------------------------------------------------------------------------
# Gitea (Self-hosted Git Server)
# -----------------------------------------------------------------------------
GITEA_URL=https://git.yourdomain.com
GITEA_BASE_URL=https://git.yourdomain.com
GITEA_TOKEN=your-gitea-personal-access-token
GITEA_API_TOKEN=your-gitea-api-token
GITEA_USER=your-gitea-username
GITEA_ORG=your-gitea-org
GITEA_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# Kubernetes / K3s Cluster
# -----------------------------------------------------------------------------
KUBECONFIG=/path/to/kubeconfig
KUBECONFIG_ENCRYPTION_KEY=your-encryption-key

# -----------------------------------------------------------------------------
# Container Registry (Harbor)
# -----------------------------------------------------------------------------
HARBOR_URL=https://registry.yourdomain.com
HARBOR_BASE_URL=https://registry.yourdomain.com
HARBOR_USERNAME=admin
HARBOR_PASSWORD=your-harbor-password
HARBOR_PROJECT=your-project
HARBOR_WEBHOOK_TOKEN=your-webhook-token

REGISTRY_URL=https://registry.yourdomain.com
REGISTRY_USERNAME=admin
REGISTRY_PASSWORD=your-registry-password

# -----------------------------------------------------------------------------
# Hetzner Cloud (VPS Provider)
# -----------------------------------------------------------------------------
HETZNER_API_TOKEN=your-hetzner-api-token
SSH_KEY_PATH=~/.ssh/id_rsa

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
# Prometheus
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_BEARER_TOKEN=your-prometheus-token

# Grafana
GRAFANA_URL=http://grafana:3000
GRAFANA_EXTERNAL_URL=https://grafana.yourdomain.com
GRAFANA_TOKEN=your-grafana-api-token
GRAFANA_API_KEY=your-grafana-api-key

# Alertmanager
ALERTMANAGER_URL=http://alertmanager:9093

# Loki (Logging)
LOKI_URL=http://loki:3100
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
LOKI_LABELS=app=control-panel

# Sentry (Error Tracking)
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=control-panel
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_WEBHOOK_SECRET=your-sentry-webhook-secret
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# PostHog (Analytics)
POSTHOG_API_KEY=your-posthog-api-key
POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_ID=your-project-id
NEXT_PUBLIC_POSTHOG_KEY=your-public-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# ArgoCD (GitOps)
# -----------------------------------------------------------------------------
ARGOCD_SERVER=https://argocd.yourdomain.com
ARGOCD_TOKEN=your-argocd-api-token

# -----------------------------------------------------------------------------
# Third-Party Integrations
# -----------------------------------------------------------------------------

# Notion (Task Management)
NOTION_API_TOKEN=secret_xxx
NOTION_WEBHOOK_SECRET=your-notion-webhook-secret

# Clerk (Authentication Service)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_API_KEY=your-clerk-api-key
CLERK_WEBHOOK_SECRET=whsec_xxx

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Supabase
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ElevenLabs (Voice AI)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id

# OpenRouter (AI Model Routing)
OPENROUTER_API_KEY=your-openrouter-api-key

# -----------------------------------------------------------------------------
# Email & Notifications
# -----------------------------------------------------------------------------
# SendGrid
SENDGRID_API_KEY=SG.xxx

# Resend
RESEND_API_KEY=re_xxx

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# Notification defaults
NOTIFICATION_FROM_EMAIL=noreply@yourdomain.com
NOTIFICATION_FROM_NAME="GMAC Control Panel"

# -----------------------------------------------------------------------------
# Expo (Mobile App)
# -----------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=your-expo-access-token

# -----------------------------------------------------------------------------
# AWS (Optional)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=optional-session-token

# -----------------------------------------------------------------------------
# Vercel (Optional - if using Vercel)
# -----------------------------------------------------------------------------
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=your-team-id

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
SECRETS_ENCRYPTION_KEY=your-32-char-encryption-key
WEBHOOK_SECRET=your-generic-webhook-secret
