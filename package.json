{
  "name": "gmac-control-panel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.1",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": ">=18",
        "react-dom": ">=18"
      },
      "ignoreMissing": [
        "react-dom"
      ]
    }
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@repo/web",
    "dev:mobile": "./scripts/dev-mobile.sh",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "mcp:build": "pnpm --filter @gmac/control-panel-mcp build",
    "mcp:create-key": "echo 'Create an API key at http://localhost:3000/settings (API Keys tab) then set CONTROL_PANEL_API_KEY env var'"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "dependencies": {
    "@notionhq/client": "^5.6.0"
  }
}
